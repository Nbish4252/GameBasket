// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// xcconfig treats `//` as a comment start, so URLs need the slash escaped
// with an empty macro expansion: $()

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// From the iOS OAuth client in Google Cloud Console (bundle ID com.gamebasket.app).
// GOOGLE_CLIENT_ID is the forward form; GOOGLE_REVERSED_CLIENT_ID is the same
// client ID with the segments reversed, used only for the URL scheme.
GOOGLE_CLIENT_ID = your-ios-client-id.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-ios-client-id

// From a separate Web OAuth client in the same Google Cloud project. Passed
// as GIDConfiguration's serverClientID so the ID token's audience matches
// what Supabase's Google provider is configured to accept — must also be
// added to the allowed Client IDs list in the Supabase dashboard.
GOOGLE_SERVER_CLIENT_ID = your-web-client-id.apps.googleusercontent.com
