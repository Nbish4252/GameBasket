// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// xcconfig treats `//` as a comment start, so URLs need the slash escaped
// with an empty macro expansion: $()

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-reversed-client-id
